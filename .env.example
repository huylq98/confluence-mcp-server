# =============================================================================
# Confluence MCP Server — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
#
# NOTE: Most users do not need a .env file — use the ConfluenceMCPSetup.exe
# wizard which writes credentials directly into Claude Desktop's config.
# The .env file is useful for developer testing with `cargo run -p server`.

# =============================================================================
# CONFLUENCE CONNECTION
# =============================================================================
CONFLUENCE_URL=https://confluence.yourcompany.com

# Authentication: use EITHER a Personal Access Token (preferred) OR username/password
# CONFLUENCE_TOKEN=your_pat_here
# CONFLUENCE_USERNAME=your_username
# CONFLUENCE_PASSWORD=your_password

# SSL settings (optional)
# CONFLUENCE_SSL_VERIFY=true                 # Set false to skip SSL verification
# CONFLUENCE_CA_BUNDLE=/path/to/ca.pem       # Or path to custom CA bundle

# Performance (optional)
# CONFLUENCE_TIMEOUT=30
# CONFLUENCE_RATE_LIMIT=5

# =============================================================================
# CONTENT
# =============================================================================
# MAX_CONTENT_LENGTH=50000    # Max characters returned per page
# DEFAULT_SEARCH_LIMIT=10     # Default number of search results
