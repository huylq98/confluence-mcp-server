{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConfluenceConnect",
  "version": "0.1.3",
  "identifier": "com.confluence-connect",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Confluence Connect",
        "width": 600,
        "height": 720,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
